{
  "manifest_version": 3,
  "name": "Access Sentinel - Visual Content Filter",
  "version": "1.0.0",
  "description": "AI-powered visual content filtering extension that protects users from inappropriate images in real-time",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Access Sentinel - Toggle Content Filter",
    "default_icon": {
      "16": "placeholder.svg",
      "48": "placeholder.svg",
      "128": "placeholder.svg"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "placeholder.svg",
    "48": "placeholder.svg", 
    "128": "placeholder.svg"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css", "blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}